# Neon PostgreSQL (production) - Vercel 대시보드에서 복사
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# YouTube Channel ID
YOUTUBE_CHANNEL_ID="UC9c1llukhxYQ5nma355O-kg"

# 사이트 기본 URL
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"

# 관리자 API 보호 (선택) — 설정하면 공개 API 호출 시 x-admin-secret 헤더가 필요합니다.
# /admin 화면은 서버 액션을 쓰므로 이 값과 무관하게 동작합니다.
ADMIN_SECRET="아무도-모르는-긴-문자열"
