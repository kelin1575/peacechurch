# Neon PostgreSQL (production) - Vercel 대시보드에서 복사
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# YouTube Channel ID
YOUTUBE_CHANNEL_ID="UC9c1llukhxYQ5nma355O-kg"

# 사이트 기본 URL
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"

# 관리자 로그인 비밀번호 (필수)
# 설정하지 않으면 /admin 이 잠긴 상태로 유지됩니다.
ADMIN_PASSWORD="원하시는-비밀번호"

# 관리자 API 추가 보호 (선택)
# 설정하면 로그인 쿠키 대신 x-admin-secret 헤더로도 호출할 수 있습니다.
ADMIN_SECRET="아무도-모르는-긴-문자열"
