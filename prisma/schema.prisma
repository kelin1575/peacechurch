// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Sermon {
  id          String    @id @default(cuid())
  youtubeId   String    @unique
  title       String
  description String?
  thumbnail   String?
  publishedAt DateTime
  category    String    @default("주일예배")
  minister    String?
  summary     String?
  interpretation String?
  scripture   String?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments    Comment[]

  @@index([category])
  @@index([publishedAt])
}

model Comment {
  id        String   @id @default(cuid())
  sermonId  String
  author    String
  content   String
  createdAt DateTime @default(now())

  sermon    Sermon   @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([sermonId])
}

model Devotional {
  id          String   @id @default(cuid())
  title       String
  scripture   String
  content     String
  prayer      String?
  date        DateTime @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model DonationInfo {
  id          String   @id @default(cuid())
  bankName    String
  accountNumber String
  accountHolder String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

/// 기도의 벽 — 성도들이 서로의 기도제목을 나누고 함께 중보하는 공간
/// "너희가 짐을 서로 지라 그리하여 그리스도의 법을 성취하라" (갈 6:2)
model PrayerRequest {
  id          String   @id @default(cuid())
  author      String   @default("익명")
  category    String   @default("기타")
  content     String
  prayCount   Int      @default(0)
  status      String   @default("published") // published | hidden
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

/// 평안소식 — 주보 공지, 교회 행사, 선교 소식
model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("교회소식") // 교회소식 | 행사 | 선교 | 광고
  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}
