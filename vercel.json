{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily-prayer",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/weekly-bulletin",
      "schedule": "0 22 * * 6"
    }
  ]
}
